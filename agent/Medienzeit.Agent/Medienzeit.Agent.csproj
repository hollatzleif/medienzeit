<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Medienzeit.Agent</RootNamespace>
    <AssemblyName>Medienzeit.Agent</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Medienzeit Sperrdienst</Product>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Medienzeit.Agent.Tests" />
  </ItemGroup>

</Project>
